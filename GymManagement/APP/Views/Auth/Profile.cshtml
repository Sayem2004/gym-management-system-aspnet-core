
@{
    ViewData["Title"] = "Profile";
}

@model DAL.EF.Tables.User

<h2>Profile</h2>

<table class="table table-bordered">

    <tr>
        <th>Name</th>
        <td>@Model.Name</td>
    </tr>

    <tr>
        <th>Phone</th>
        <td>@Model.Phone</td>
    </tr>

    <tr>
        <th>Email</th>
        <td>@Model.Email</td>
    </tr>

    <tr>
        <th>Username</th>
        <td>@Model.Username</td>
    </tr>

</table>

<a asp-action="EditProfile" class="btn btn-warning">
    Edit Profile
</a>

<a asp-action="DeleteProfile" class="btn btn-danger">
    Delete Profile
</a>

