@model List<BLL.DTOs.TrainerDTO>

@{
    ViewData["Title"] = "Index";
}

<h2>Trainer List</h2>

<a asp-action="Create" class="btn btn-primary">
    Add Trainer
</a>

<br />
<br />

<table class="table table-bordered">

    <tr>

        <th>ID</th>
        <th>Name</th>
        <th>Speciality</th>
        <th>Phone</th>
        <th>Experience</th>
        <th>Action</th>

    </tr>

    @foreach (var item in Model)
    {
        <tr>

            <td>@item.TrainerId</td>

            <td>@item.Name</td>

            <td>@item.Speciality</td>

            <td>@item.Phone</td>

            <td>@item.Experience</td>

            <td>

                <a asp-action="Edit"
                   asp-route-id="@item.TrainerId"
                   class="btn btn-primary">

                    Edit

                </a>

                <a asp-action="Delete"
                   asp-route-id="@item.TrainerId"
                   class="btn btn-primary">

                    Delete

                </a>

                <a asp-controller="Package"
                   asp-action="Create"
                   asp-route-id="@item.TrainerId"
                   class="btn btn-primary">

                    Add Package

                </a>

                

            </td>

        </tr>
    }


</table>